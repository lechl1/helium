+gfx::RoundedCornersF InfoBarContainerView::GetInfoBarRadii() const {
+  if (!ShouldUseRoundedFrame()) {
+    return gfx::RoundedCornersF();
+  }
+
+  const int generic_radius = GetGenericFrameRadius();
+  if (rounded_frame_top_chrome_reveal_ratio_ > 0.0f) {
+    return gfx::RoundedCornersF(generic_radius);
+  }
+
+  const int frame_radius = GetPaddedFrameRadius();
+  return gfx::RoundedCornersF(
+      leading_side_chrome_attached_ ? generic_radius : frame_radius,
+      trailing_side_chrome_attached_ ? generic_radius : frame_radius,
+      generic_radius, generic_radius);
+}
